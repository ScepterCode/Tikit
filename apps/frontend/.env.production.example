# Frontend production environment — TEMPLATE
#
# Do NOT commit a real .env.production (it is git-ignored). Set these values in
# the deploy platform's dashboard instead:
#   - Netlify:  Site settings → Environment variables
#   - Vercel:   Project → Settings → Environment Variables
#
# Every VITE_-prefixed value is inlined into the public client bundle. Never put
# a secret here (no Flutterwave secret/encryption key, no Supabase service key).

# --- Backend API ---------------------------------------------------------------
# Canonical variable. All API calls resolve their base URL from this.
VITE_API_URL=https://api.example.com
# Legacy alias, still read as a fallback by src/config/api.ts. Optional.
# VITE_API_BASE_URL=https://api.example.com

# --- Supabase (public anon key only) -----------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Payments (public key only) ---------------------------------------------
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
VITE_PAYMENT_PROVIDER=flutterwave

# --- App / branding -------------------------------------------------------------
VITE_APP_NAME=Grooovy
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production
VITE_CDN_URL=https://cdn.example.com
VITE_USSD_SHORT_CODE=*7477#

# --- Feature flags ------------------------------------------------------------
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true

# --- Security / limits ------------------------------------------------------
VITE_ENABLE_HTTPS_ONLY=true
VITE_ENABLE_STRICT_CSP=true
VITE_PAYMENT_TIMEOUT=300000
VITE_MAX_PAYMENT_AMOUNT=1000000

# --- Error tracking (optional) ----------------------------------------------
# Leave unset to disable Sentry entirely. When set, errors are reported with
# PII off and token-shaped values scrubbed (src/observability/sentry.ts).
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
